rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             (request.auth.token.email == "mstfyalswdany913@gmail.com" ||
              request.auth.uid == "gsU8IdYVsxgHdwdbsmDVh1ClzO92");
    }

    function isAdmin() {
      return isSuperAdmin() ||
             (isAuthenticated() &&
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ── Users ─────────────────────────────────────────────────────
    match /users/{userId} {
      // Admin can list ALL users; each user can only read their own doc
      allow list: if isAuthenticated() && isAdmin();
      allow get:  if isAuthenticated() && (isOwner(userId) || isAdmin());

      // New user creates their own profile on first sign-in (relaxed validation)
      allow create: if (
                      isAuthenticated() && isOwner(userId) &&
                      request.resource.data.uid == userId &&
                      request.resource.data.role in ['admin', 'user'] &&
                      request.resource.data.createdAt is timestamp &&
                      (request.resource.data.role == 'user' || isSuperAdmin())
                    ) || (
                      isAuthenticated() && isAdmin() &&
                      request.resource.data.uid == userId &&
                      request.resource.data.role in ['admin', 'user'] &&
                      (request.resource.data.role == 'user' || isSuperAdmin())
                    );

      // User can update their own profile (role stays the same); admin can update anything
      allow update: if isAuthenticated() &&
                    (
                      (isOwner(userId) &&
                       request.resource.data.role == resource.data.role &&
                       request.resource.data.createdAt == resource.data.createdAt) ||
                      (
                        isAdmin() &&
                        (
                          isSuperAdmin() ||
                          (
                            userId != "gsU8IdYVsxgHdwdbsmDVh1ClzO92" &&
                            resource.data.email != "mstfyalswdany913@gmail.com"
                          )
                        )
                      )
                    );

      allow delete: if isAdmin() &&
                    (
                      isSuperAdmin() ||
                      (
                        userId != "gsU8IdYVsxgHdwdbsmDVh1ClzO92" &&
                        resource.data.email != "mstfyalswdany913@gmail.com"
                      )
                    );
    }

    // ── Quizzes ───────────────────────────────────────────────────
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasAll(['title', 'questions', 'authorUid', 'createdAt']) &&
                    request.resource.data.authorUid == request.auth.uid &&
                    request.resource.data.title is string &&
                    request.resource.data.title.size() > 0 &&
                    request.resource.data.questions is list;

      allow update: if isAuthenticated() &&
                    (resource.data.authorUid == request.auth.uid || isAdmin());

      allow delete: if isAuthenticated() &&
                    (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // ── Results ───────────────────────────────────────────────────
    match /results/{resultId} {
      allow read: if isAuthenticated() &&
                  (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasAll(['quizId', 'userId', 'score', 'totalQuestions', 'completedAt']) &&
                    request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ── Todos ─────────────────────────────────────────────────────
    match /todos/{todoId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasAll(['userId', 'text', 'completed', 'createdAt']) &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.text is string &&
                    request.resource.data.text.size() > 0 &&
                    request.resource.data.text.size() <= 500 &&
                    request.resource.data.completed is bool;

      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── Mind Maps ─────────────────────────────────────────────────
    match /mindmaps/{mapId} {
      allow read: if isAuthenticated() &&
                  (resource.data.authorUid == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasAll(['topic', 'title', 'category', 'data', 'authorUid', 'createdAt']) &&
                    request.resource.data.authorUid == request.auth.uid &&
                    request.resource.data.createdAt is timestamp;

      allow update, delete: if isAuthenticated() &&
                             (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // ── Visitors ─────────────────────────────────────────────────
    // Write is open (anonymous tracking); only admins can read
    match /visitors/{sessionId} {
      allow create: if request.resource.data.keys().hasAll(['sessionId', 'firstVisit', 'lastVisit', 'visitCount']) &&
                    request.resource.data.sessionId is string &&
                    request.resource.data.firstVisit is timestamp &&
                    request.resource.data.lastVisit is timestamp &&
                    request.resource.data.visitCount is number;

      allow update: if true;

      allow read, delete: if isAuthenticated() && isAdmin();
    }

    // ── Visit Logs (page-level tracking) ──────────────────────────
    match /visitLogs/{logId} {
      allow create: if true;
      allow read, delete: if isAuthenticated() && isAdmin();
    }

  }
}
