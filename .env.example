# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Groq is the primary free-tier quiz generation provider.
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="llama-3.1-70b-versatile"

# Cost guards for MVP usage.
QUIZ_MAX_TEXT_CHARS="12000"
QUIZ_MAX_QUESTIONS="30"
# Optional global cap. Use 0 to let each pricing plan control its own daily limit.
QUIZ_RATE_LIMIT_MAX="0"
QUIZ_RATE_LIMIT_WINDOW_MS="86400000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: receive Owner AI incident alerts in Slack/Discord/Make/Zapier/etc.
OWNER_ALERT_WEBHOOK_URL="MY_OWNER_ALERT_WEBHOOK_URL"
